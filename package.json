{
  "name": "0xdps-portfolio",
  "version": "2.0.0",
  "description": "Personal portfolio website for Devendra Pratap Singh - Static site with build-time rendering",
  "type": "module",
  "scripts": {
    "minify:css": "esbuild website/assets/css/styles.css --minify --outfile=build/assets/css/styles.min.css",
    "minify:privacy-css": "esbuild website/assets/css/privacy.css --minify --outfile=build/assets/css/privacy.min.css",
    "minify:js": "esbuild website/assets/js/scripts.js --minify --outfile=build/assets/js/scripts.min.js",
    "minify:privacy-js": "esbuild website/assets/js/privacy-theme.js --minify --outfile=build/assets/js/privacy-theme.min.js",
    "copy:assets": "node scripts/copy-assets.js",
    "generate:html": "node scripts/build.js",
    "minify:html": "html-minifier-terser --collapse-whitespace --remove-comments --minify-css true --minify-js true -o build/index.html build/index.html",
    "minify:privacy-html": "for file in build/privacy/*.html; do html-minifier-terser --collapse-whitespace --remove-comments --minify-css true --minify-js true -o \"$file\" \"$file\"; done",
    "build": "npm-run-all copy:assets --parallel minify:css minify:privacy-css minify:js minify:privacy-js --sequential generate:html minify:html minify:privacy-html",
    "watch": "chokidar 'website/**/*' -c 'npm run build'",
    "serve": "reload -b -p 8000 -d build",
    "dev": "npm-run-all build --parallel watch serve"
  },
  "keywords": [
    "portfolio",
    "personal-website",
    "developer-portfolio",
    "static-site",
    "handlebars",
    "esbuild",
    "frontend-developer",
    "fullstack-developer",
    "node.js",
    "javascript",
    "web-development",
    "responsive-design",
    "build-time-rendering"
  ],
  "author": "Devendra Pratap Singh",
  "license": "MIT",
  "devDependencies": {
    "chokidar-cli": "^3.0.0",
    "esbuild": "^0.19.0",
    "handlebars": "^4.7.8",
    "html-minifier-terser": "^7.2.0",
    "npm-run-all": "^4.1.5",
    "reload": "^3.4.2"
  },
  "engines": {
    "node": "22.x"
  }
}
