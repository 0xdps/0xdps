---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Devendra Pratap Singh — Principal Software Engineer & System Architect',
  description = 'Principal Software Engineer with 10+ years building scalable backend systems across gaming, automotive, NFT, and entertainment. Ex-Zynga FarmVille, Ex-BookMyShow. Currently at Spinny.',
} = Astro.props;

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Devendra Pratap Singh',
  alternateName: '0xdps',
  url: 'https://dps.codes/',
  image: 'https://dps.codes/assets/profile/profile.webp',
  email: 'dps.manit@gmail.com',
  sameAs: [
    'https://www.linkedin.com/in/0xdps',
    'https://github.com/0xdps',
    'https://twitter.com/0xdps',
    'https://0xdps.medium.com',
    'https://topmate.io/i0xdps',
  ],
  jobTitle: 'Principal Software Engineer',
  worksFor: {
    '@type': 'Organization',
    name: 'Spinny',
    description: "India's Largest Used Car Platform",
  },
  alumniOf: {
    '@type': 'CollegeOrUniversity',
    name: 'National Institute of Technology, Bhopal',
  },
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Delhi NCR',
    addressCountry: 'IN',
  },
  knowsAbout: [
    'Backend Development',
    'System Design',
    'Distributed Systems',
    'Cloud Migration',
    'AWS',
    'GCP',
    'Python',
    'Node.js',
    'Go',
    'Java',
    'Microservices',
    'Performance Optimization',
    'Engineering Leadership',
  ],
  description:
    'Principal Software Engineer with 10+ years of experience building scalable backend systems across gaming, automotive, NFT, and entertainment industries.',
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Primary SEO -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content="Devendra Pratap Singh, 0xdps, Principal Software Engineer, Backend Engineer, System Design, Distributed Systems, Python, Node.js, Go, Java, Zynga, FarmVille, BookMyShow, Spinny, Cloud Migration, AWS GCP, Engineering Leader, India" />
    <meta name="author" content="Devendra Pratap Singh" />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href="https://dps.codes/" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://dps.codes/" />
    <meta property="og:title" content="Devendra Pratap Singh — Principal Software Engineer" />
    <meta property="og:description" content="10+ years building systems that scale. Ex-Zynga FarmVille, Ex-BookMyShow. Currently Principal Engineer @ Spinny." />
    <meta property="og:image" content="https://dps.codes/assets/profile/profile.webp" />
    <meta property="og:image:alt" content="Devendra Pratap Singh — Principal Software Engineer" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content="Devendra Pratap Singh" />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@0xdps" />
    <meta name="twitter:creator" content="@0xdps" />
    <meta name="twitter:title" content="Devendra Pratap Singh — Principal Software Engineer" />
    <meta name="twitter:description" content="10+ years building systems that scale. Ex-Zynga FarmVille, Ex-BookMyShow. Currently @ Spinny." />
    <meta name="twitter:image" content="https://dps.codes/assets/profile/profile.webp" />

    <!-- Favicons -->
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/favicon.ico" />

    <!-- PWA / Theme -->
    <meta name="theme-color" content="#07090e" />
    <meta name="apple-mobile-web-app-capable" content="yes" />

    <!-- Schema.org / JSON-LD -->
    <Fragment set:html={`<script type="application/ld+json">${JSON.stringify(personSchema)}</script>`} />

    <!-- Umami Analytics -->
    <script
      defer
      src="https://assets.0xlabs.space/anately.js"
      data-website-id="b1b80cdf-1466-4469-ad6c-486952ce3412"
      data-host-url="https://analytics.0xlabs.space"
    ></script>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Unbounded:wght@600;700;800&family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;0,9..40,600;1,9..40,400&family=Fira+Code:wght@400;500&display=swap"
      rel="stylesheet"
    />

    <style is:global>
      /* VS Code Theme Variables */
      :root {
        --vscode-bg: #0d1117;
        --vscode-fg: #e6edf3;
        --vscode-border: #30363d;
        --vscode-accent: #58a6ff;
        --vscode-titlebar-bg: #010409;
        --vscode-activity-bg: #0d1117;
        --vscode-activity-fg: #7d8590;
        --vscode-activity-active: #e6edf3;
        --vscode-sidebar-bg: #0d1117;
        --vscode-sidebar-fg: #7d8590;
        --vscode-sidebar-active: #e6edf3;
        --vscode-tab-bg: #010409;
        --vscode-tab-active: #0d1117;
        --vscode-tab-inactive: #010409;
        --vscode-tab-hover: #161b22;
        --vscode-tab-fg: #7d8590;
        --vscode-editor-bg: #0d1117;
        --vscode-gutter-bg: #0d1117;
        --vscode-gutter-fg: #484f58;
        --vscode-breadcrumb-bg: #0d1117;
        --vscode-status-bg: #161b22;
        --vscode-status-fg: #7d8590;
        --vscode-hover-bg: rgba(177, 186, 196, 0.12);
        --vscode-active-bg: rgba(88, 166, 255, 0.15);
        --vscode-close-hover: rgba(248, 81, 73, 0.6);
        --vscode-font: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        --vscode-font-mono: 'Fira Code', 'SF Mono', Monaco, monospace;
        --vscode-text-dim: #484f58;
      }

      /* VS Code Layout */
      .vscode-app {
        width: 100vw;
        height: 100vh;
        display: flex;
        flex-direction: column;
        background: var(--vscode-bg);
        color: var(--vscode-fg);
        font-family: var(--vscode-font);
        font-size: 13px;
        line-height: 1.5;
        overflow: hidden;
      }

      .vscode-titlebar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        height: 30px;
        background: var(--vscode-titlebar-bg);
        border-bottom: 1px solid var(--vscode-border);
        padding: 0 12px;
        flex-shrink: 0;
        user-select: none;
      }

      .titlebar-left, .titlebar-right {
        display: flex;
        align-items: center;
        gap: 8px;
        min-width: 120px;
      }
      .titlebar-right { justify-content: flex-end; }
      .titlebar-center { flex: 1; text-align: center; }
      .titlebar-icon { color: var(--vscode-fg); opacity: 0.7; }
      .titlebar-text { font-size: 12px; color: var(--vscode-fg); opacity: 0.9; }
      .titlebar-filename { font-size: 12px; color: var(--vscode-fg); opacity: 0.6; }
      .titlebar-dot { width: 10px; height: 10px; border-radius: 50%; opacity: 0.8; }

      .vscode-body {
        display: flex;
        flex: 1;
        overflow: hidden;
      }

      .vscode-workspace {
        display: flex;
        flex-direction: column;
        flex: 1;
        overflow: hidden;
      }

      .vscode-editor-area {
        flex: 1;
        overflow: hidden;
        position: relative;
      }

      /* Activity Bar */
      .activity-bar {
        width: 48px;
        background: var(--vscode-activity-bg);
        border-right: 1px solid var(--vscode-border);
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: space-between;
        padding: 8px 0;
        flex-shrink: 0;
      }
      .activity-top, .activity-bottom {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 4px;
      }
      .activity-item {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 40px;
        height: 40px;
        border: none;
        background: none;
        color: var(--vscode-activity-fg);
        border-radius: 6px;
        cursor: pointer;
        transition: all 0.15s ease;
        position: relative;
      }
      .activity-item:hover { color: var(--vscode-activity-active); background: var(--vscode-hover-bg); }
      .activity-item.active { color: var(--vscode-activity-active); }
      .activity-item.active::before {
        content: '';
        position: absolute;
        left: 0;
        top: 50%;
        transform: translateY(-50%);
        width: 2px;
        height: 20px;
        background: var(--vscode-accent);
        border-radius: 0 2px 2px 0;
      }

      /* Sidebar */
      .sidebar {
        width: 240px;
        background: var(--vscode-sidebar-bg);
        border-right: 1px solid var(--vscode-border);
        display: flex;
        flex-direction: column;
        flex-shrink: 0;
        overflow: hidden;
      }
      .sidebar.collapsed { width: 0; border-right: none; }
      .sidebar-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 8px 14px;
        height: 36px;
      }
      .sidebar-title {
        font-size: 10px;
        font-weight: 600;
        letter-spacing: 0.08em;
        color: var(--vscode-sidebar-fg);
        text-transform: uppercase;
      }
      .sidebar-action {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 22px;
        height: 22px;
        border: none;
        background: none;
        color: var(--vscode-sidebar-fg);
        border-radius: 4px;
        cursor: pointer;
        transition: all 0.15s;
      }
      .sidebar-action:hover { color: var(--vscode-sidebar-active); background: var(--vscode-hover-bg); }
      .sidebar-content { flex: 1; overflow-y: auto; padding: 4px 0; }

      .folder-tree { user-select: none; }
      .folder-item {
        display: flex;
        align-items: center;
        gap: 4px;
        padding: 3px 12px;
        cursor: pointer;
        color: var(--vscode-sidebar-fg);
        font-size: 12px;
      }
      .folder-item:hover { color: var(--vscode-sidebar-active); }
      .folder-toggle {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 16px;
        height: 16px;
        border: none;
        background: none;
        color: inherit;
        cursor: pointer;
        padding: 0;
      }
      .folder-toggle .chevron { transition: transform 0.15s; }
      .folder-item:not(.open) .chevron { transform: rotate(-90deg); }
      .folder-icon { display: flex; align-items: center; opacity: 0.8; }
      .folder-name { font-weight: 600; }

      .folder-children { padding-left: 8px; }
      .folder-item:not(.open) + .folder-children { display: none; }

      .file-item {
        display: flex;
        align-items: center;
        gap: 6px;
        padding: 3px 12px 3px 28px;
        cursor: pointer;
        color: var(--vscode-sidebar-fg);
        font-size: 12px;
        border-radius: 4px;
        margin: 0 4px;
        transition: all 0.1s;
      }
      .file-item:hover {
        background: var(--vscode-hover-bg);
        color: var(--vscode-sidebar-active);
      }
      .file-item.active {
        background: var(--vscode-accent);
        color: #fff;
      }
      .file-icon { display: flex; align-items: center; flex-shrink: 0; }
      .file-name { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

      /* Tab Bar */
      .tab-bar {
        display: flex;
        align-items: center;
        height: 36px;
        background: var(--vscode-tab-bg);
        border-bottom: 1px solid var(--vscode-border);
        flex-shrink: 0;
        overflow: hidden;
      }
      .tab-list {
        display: flex;
        flex: 1;
        overflow-x: auto;
        scrollbar-width: none;
      }
      .tab-list::-webkit-scrollbar { display: none; }
      .tab-item {
        display: flex;
        align-items: center;
        gap: 6px;
        padding: 0 12px;
        height: 36px;
        min-width: 120px;
        max-width: 200px;
        background: var(--vscode-tab-inactive);
        border-right: 1px solid var(--vscode-border);
        color: var(--vscode-tab-fg);
        cursor: pointer;
        transition: all 0.1s;
        position: relative;
        flex-shrink: 0;
      }
      .tab-item:hover { background: var(--vscode-tab-hover); }
      .tab-item.active {
        background: var(--vscode-tab-active);
        color: var(--vscode-fg);
      }
      .tab-item.active::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 1px;
        background: var(--vscode-accent);
      }
      .tab-icon { display: flex; align-items: center; opacity: 0.7; flex-shrink: 0; }
      .tab-name { font-size: 12px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; flex: 1; }
      .tab-close {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 16px;
        height: 16px;
        border: none;
        background: none;
        color: inherit;
        border-radius: 3px;
        cursor: pointer;
        opacity: 0;
        transition: all 0.15s;
        padding: 0;
      }
      .tab-item:hover .tab-close { opacity: 1; }
      .tab-close:hover { background: var(--vscode-hover-bg); }
      .tab-actions {
        display: flex;
        align-items: center;
        padding: 0 8px;
      }
      .tab-action {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 24px;
        height: 24px;
        border: none;
        background: none;
        color: var(--vscode-sidebar-fg);
        border-radius: 4px;
        cursor: pointer;
      }
      .tab-action:hover { background: var(--vscode-hover-bg); color: var(--vscode-fg); }

      /* Editor */
      .editor {
        width: 100%;
        height: 100%;
        overflow: auto;
        display: flex;
        background: var(--vscode-editor-bg);
      }
      .editor-pane {
        display: none;
        width: 100%;
        min-height: 100%;
        flex-direction: column;
      }
      .editor-pane.active { display: flex !important; }
      .editor-breadcrumbs {
        display: flex;
        align-items: center;
        gap: 6px;
        padding: 6px 16px;
        background: var(--vscode-breadcrumb-bg);
        border-bottom: 1px solid var(--vscode-border);
        font-size: 11px;
        color: var(--vscode-sidebar-fg);
        flex-shrink: 0;
      }
      .breadcrumb-item { cursor: pointer; transition: color 0.1s; }
      .breadcrumb-item:hover { color: var(--vscode-fg); }
      .breadcrumb-item.active { color: var(--vscode-fg); font-weight: 500; }
      .breadcrumb-sep { opacity: 0.5; }
      .editor-body {
        flex: 1;
        overflow: auto;
        padding: 24px 32px;
      }

      /* File Content Styles */
      .file-content {
        max-width: 900px;
        margin: 0 auto;
        width: 100%;
        padding: 20px 0;
      }
      .file-content .s-label {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        font-family: var(--ff-mono);
        font-size: 0.72rem;
        font-weight: 500;
        color: var(--cyan);
        letter-spacing: 0.14em;
        text-transform: uppercase;
        margin-bottom: 14px;
      }
      .file-content .s-label::before {
        content: '';
        width: 26px;
        height: 1px;
        background: var(--cyan);
      }
      .file-content .s-title {
        font-family: var(--ff-display);
        font-size: clamp(1.6rem, 3.5vw, 2.4rem);
        font-weight: 800;
        letter-spacing: -0.02em;
        color: var(--text);
        line-height: 1.12;
        margin-bottom: 16px;
      }
      .file-content .s-sub {
        font-size: 1.0625rem;
        color: var(--text-2);
        max-width: 560px;
        line-height: 1.75;
        margin-bottom: 48px;
      }

      /* README specific */
      .readme-hero {
        display: flex;
        align-items: center;
        gap: 24px;
        margin-bottom: 32px;
      }
      .readme-avatar img {
        width: 100px;
        height: 100px;
        border-radius: 50%;
        border: 2px solid var(--vscode-border);
      }
      .readme-header h1 {
        font-family: var(--ff-display);
        font-size: 1.8rem;
        font-weight: 800;
        margin-bottom: 4px;
      }
      .readme-handle {
        color: var(--vscode-accent);
        font-family: var(--ff-mono);
        font-size: 0.85rem;
        margin-bottom: 8px;
      }
      .readme-tagline {
        color: var(--text-2);
        font-size: 0.95rem;
      }
      .readme-stats {
        display: flex;
        gap: 24px;
        margin-bottom: 32px;
        padding: 16px 20px;
        background: var(--surface);
        border: 1px solid var(--vscode-border);
        border-radius: 12px;
      }
      .readme-stat {
        display: flex;
        flex-direction: column;
        gap: 4px;
      }
      .rs-val {
        font-family: var(--ff-display);
        font-size: 1.4rem;
        font-weight: 800;
        color: var(--cyan);
      }
      .rs-label {
        font-size: 0.7rem;
        color: var(--text-dim);
        text-transform: uppercase;
        letter-spacing: 0.08em;
      }
      .readme-section { margin-bottom: 28px; }
      .readme-section h2 {
        font-family: var(--ff-display);
        font-size: 1rem;
        font-weight: 700;
        margin-bottom: 12px;
        color: var(--text);
      }
      .readme-current {
        background: var(--surface);
        border: 1px solid var(--vscode-border);
        border-radius: 12px;
        padding: 16px 20px;
      }
      .rc-badge {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 10px;
        font-weight: 600;
        font-size: 0.9rem;
      }
      .rc-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: #28c840;
        animation: pulse 2s ease-in-out infinite;
      }
      @keyframes pulse {
        0%, 100% { opacity: 1; }
        50% { opacity: 0.5; }
      }
      .readme-links {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
      }
      .readme-link {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 8px 14px;
        background: var(--surface);
        border: 1px solid var(--vscode-border);
        border-radius: 8px;
        color: var(--text-2);
        font-size: 0.85rem;
        transition: all 0.2s;
      }
      .readme-link:hover {
        border-color: var(--vscode-accent);
        color: var(--vscode-accent);
        transform: translateY(-1px);
      }

      /* Intro file */
      .intro-file .intro-prose p {
        color: var(--text-2);
        line-height: 1.85;
        font-size: 1.0625rem;
        margin-bottom: 20px;
      }
      .intro-file .intro-cards {
        display: flex;
        flex-direction: column;
        gap: 16px;
        margin-top: 32px;
      }

      /* Welcome Screen */
      .welcome-screen {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 100%;
        height: 100%;
        overflow: auto;
      }
      .welcome-content {
        text-align: center;
        padding: 48px 32px;
        max-width: 600px;
      }
      .welcome-logo {
        margin-bottom: 24px;
      }
      .welcome-logo svg {
        margin: 0 auto;
      }
      .welcome-title {
        font-family: var(--ff-display);
        font-size: 2rem;
        font-weight: 800;
        margin-bottom: 8px;
        color: var(--text);
      }
      .welcome-subtitle {
        color: var(--text-2);
        font-size: 1rem;
        margin-bottom: 40px;
      }
      .welcome-sections {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 24px;
        text-align: left;
        margin-bottom: 32px;
      }
      .welcome-section-title {
        font-size: 11px;
        font-weight: 600;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--vscode-sidebar-fg);
        margin-bottom: 12px;
      }
      .welcome-link {
        display: flex;
        align-items: center;
        gap: 8px;
        width: 100%;
        padding: 6px 8px;
        border: none;
        background: none;
        color: var(--vscode-fg);
        font-size: 13px;
        cursor: pointer;
        border-radius: 4px;
        text-align: left;
        transition: all 0.15s;
      }
      .welcome-link:hover {
        background: var(--vscode-hover-bg);
        color: var(--vscode-accent);
      }
      .welcome-link-folder {
        margin-left: auto;
        font-size: 11px;
        color: var(--vscode-sidebar-fg);
      }
      .welcome-walkthrough {
        display: flex;
        align-items: flex-start;
        gap: 10px;
        padding: 8px;
        border-radius: 6px;
        transition: background 0.15s;
      }
      .welcome-walkthrough:hover {
        background: var(--vscode-hover-bg);
      }
      .walkthrough-icon { font-size: 1.2rem; }
      .walkthrough-title { font-size: 13px; font-weight: 500; color: var(--vscode-fg); }
      .walkthrough-desc { font-size: 11px; color: var(--vscode-sidebar-fg); margin-top: 2px; }
      .welcome-footer {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        font-size: 11px;
        color: var(--vscode-sidebar-fg);
      }
      .welcome-shortcuts {
        display: flex;
        justify-content: center;
        gap: 16px;
        margin-top: 24px;
      }
      .shortcut {
        display: flex;
        align-items: center;
        gap: 4px;
        font-size: 11px;
        color: var(--vscode-sidebar-fg);
      }
      .shortcut-key {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 20px;
        height: 20px;
        padding: 0 4px;
        background: var(--vscode-hover-bg);
        border: 1px solid var(--vscode-border);
        border-radius: 4px;
        font-family: var(--vscode-font-mono);
        font-size: 10px;
        color: var(--vscode-fg);
      }

      /* Status Bar */
      .status-bar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        height: 24px;
        background: var(--vscode-status-bg);
        border-top: 1px solid var(--vscode-border);
        padding: 0 8px;
        flex-shrink: 0;
        font-size: 11px;
        color: var(--vscode-status-fg);
        user-select: none;
      }
      .status-left, .status-center, .status-right {
        display: flex;
        align-items: center;
        gap: 2px;
      }
      .status-item {
        display: flex;
        align-items: center;
        gap: 4px;
        padding: 2px 8px;
        border-radius: 3px;
        cursor: default;
        transition: background 0.15s;
      }
      .status-item:hover { background: var(--vscode-hover-bg); }
      .status-branch { cursor: pointer; }
      .status-link {
        color: inherit;
        text-decoration: none;
      }
      .status-link:hover { color: var(--vscode-fg); }

      /* Responsive */
      @media (max-width: 768px) {
        .sidebar { width: 200px; }
        .welcome-sections { grid-template-columns: 1fr; }
        .readme-hero { flex-direction: column; text-align: center; }
        .readme-stats { flex-wrap: wrap; }
      }
      @media (max-width: 560px) {
        .sidebar { display: none; }
        .activity-bar { width: 40px; }
      }
    </style>
  </head>
  <body>
    <slot />
  </body>
</html>

