---
import ActivityBar from './ActivityBar.astro';
import Sidebar from './Sidebar.astro';
import TabBar from './TabBar.astro';
import Editor from './Editor.astro';
import StatusBar from './StatusBar.astro';
import WelcomeScreen from './WelcomeScreen.astro';
import { portfolioFiles } from '../../data/portfolioFiles';

const files = portfolioFiles;
---

<div id="vscode-app" class="vscode-app">
  <!-- Title Bar -->
  <div class="vscode-titlebar">
    <div class="titlebar-left">
      <svg class="titlebar-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
        <line x1="9" y1="3" x2="9" y2="21"/>
        <line x1="15" y1="3" x2="15" y2="21"/>
        <line x1="3" y1="9" x2="21" y2="9"/>
        <line x1="3" y1="15" x2="21" y2="15"/>
      </svg>
      <span class="titlebar-text">0xdps — portfolio</span>
    </div>
    <div class="titlebar-center">
      <span class="titlebar-filename" id="titlebar-filename">Welcome</span>
    </div>
    <div class="titlebar-right">
      <span class="titlebar-dot" style="background:#ffbd2e;"></span>
      <span class="titlebar-dot" style="background:#28c840;"></span>
    </div>
  </div>

  <!-- Main Layout -->
  <div class="vscode-body">
    <ActivityBar />
    <Sidebar files={files} />
    
    <div class="vscode-workspace">
      <TabBar />
      
      <div class="vscode-editor-area">
        <WelcomeScreen />
        <Editor files={files} />
      </div>
    </div>
  </div>

  <StatusBar />
</div>

<script>
  import '../../scripts/vscodeState.ts';
</script>

<style>
  .vscode-app {
    width: 100vw;
    height: 100vh;
    display: flex;
    flex-direction: column;
    background: var(--vscode-bg);
    color: var(--vscode-fg);
    font-family: var(--vscode-font);
    font-size: 13px;
    line-height: 1.5;
    overflow: hidden;
  }

  .vscode-titlebar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 30px;
    background: var(--vscode-titlebar-bg);
    border-bottom: 1px solid var(--vscode-border);
    padding: 0 12px;
    flex-shrink: 0;
    -webkit-app-region: drag;
    user-select: none;
  }

  .titlebar-left,
  .titlebar-right {
    display: flex;
    align-items: center;
    gap: 8px;
    min-width: 120px;
  }

  .titlebar-right {
    justify-content: flex-end;
  }

  .titlebar-center {
    flex: 1;
    text-align: center;
  }

  .titlebar-icon {
    color: var(--vscode-fg);
    opacity: 0.7;
  }

  .titlebar-text {
    font-size: 12px;
    color: var(--vscode-fg);
    opacity: 0.9;
  }

  .titlebar-filename {
    font-size: 12px;
    color: var(--vscode-fg);
    opacity: 0.6;
  }

  .titlebar-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    opacity: 0.8;
  }

  .vscode-body {
    display: flex;
    flex: 1;
    overflow: hidden;
  }

  .vscode-workspace {
    display: flex;
    flex-direction: column;
    flex: 1;
    overflow: hidden;
  }

  .vscode-editor-area {
    flex: 1;
    overflow: hidden;
    position: relative;
  }
</style>
