---
import ActivityBar from './ActivityBar.astro';
import Sidebar from './Sidebar.astro';
import TabBar from './TabBar.astro';
import Editor from './Editor.astro';
import StatusBar from './StatusBar.astro';
import WelcomeScreen from './WelcomeScreen.astro';
import { portfolioFiles } from '../../data/portfolioFiles';

const files = portfolioFiles;
---

<div id="vscode-app" class="vscode-app">
  <!-- Title Bar -->
  <div class="vscode-titlebar">
    <div class="titlebar-left">
      <svg class="titlebar-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
        <line x1="9" y1="3" x2="9" y2="21"/>
        <line x1="15" y1="3" x2="15" y2="21"/>
        <line x1="3" y1="9" x2="21" y2="9"/>
        <line x1="3" y1="15" x2="21" y2="15"/>
      </svg>
      <span class="titlebar-text">0xdps — portfolio</span>
    </div>
    <div class="titlebar-center">
      <span class="titlebar-filename" id="titlebar-filename">Welcome</span>
    </div>
    <div class="titlebar-right">
      <span class="titlebar-dot" style="background:#ffbd2e;"></span>
      <span class="titlebar-dot" style="background:#28c840;"></span>
    </div>
  </div>

  <!-- Main Layout -->
  <div class="vscode-body">
    <ActivityBar />
    <Sidebar files={files} />
    
    <div class="vscode-workspace">
      <TabBar />
      
      <div class="vscode-editor-area">
        <WelcomeScreen />
        <Editor files={files} />
      </div>
    </div>
  </div>

  <StatusBar />

  <!-- Cmd+P Quick Open Overlay -->
  <div id="quick-open-overlay" class="quick-open-overlay">
    <div class="quick-open-panel">
      <div class="quick-open-header">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="opacity:0.5;flex-shrink:0">
          <circle cx="11" cy="11" r="8"/>
          <line x1="21" y1="21" x2="16.65" y2="16.65"/>
        </svg>
        <input type="text" id="quick-open-input" class="quick-open-input" placeholder="Go to file..." autocomplete="off" spellcheck="false" />
        <kbd class="quick-open-esc">esc</kbd>
      </div>
      <div id="quick-open-results" class="quick-open-results"></div>
    </div>
  </div>
</div>

<script>
  import '../../scripts/vscodeState.ts';
</script>

<style>
  .vscode-app {
    width: 100vw;
    height: 100vh;
    display: flex;
    flex-direction: column;
    background: var(--vscode-bg);
    color: var(--vscode-fg);
    font-family: var(--vscode-font);
    font-size: 13px;
    line-height: 1.5;
    overflow: hidden;
  }

  .vscode-titlebar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 30px;
    background: var(--vscode-titlebar-bg);
    border-bottom: 1px solid var(--vscode-border);
    padding: 0 12px;
    flex-shrink: 0;
    -webkit-app-region: drag;
    user-select: none;
  }

  .titlebar-left,
  .titlebar-right {
    display: flex;
    align-items: center;
    gap: 8px;
    min-width: 120px;
  }

  .titlebar-right {
    justify-content: flex-end;
  }

  .titlebar-center {
    flex: 1;
    text-align: center;
  }

  .titlebar-icon {
    color: var(--vscode-fg);
    opacity: 0.7;
  }

  .titlebar-text {
    font-size: 12px;
    color: var(--vscode-fg);
    opacity: 0.9;
  }

  .titlebar-filename {
    font-size: 12px;
    color: var(--vscode-fg);
    opacity: 0.6;
  }

  .titlebar-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    opacity: 0.8;
  }

  .vscode-body {
    display: flex;
    flex: 1;
    overflow: hidden;
  }

  .vscode-workspace {
    display: flex;
    flex-direction: column;
    flex: 1;
    overflow: hidden;
  }

  .vscode-editor-area {
    flex: 1;
    overflow: hidden;
    position: relative;
  }

  /* Quick Open Overlay */
  .quick-open-overlay {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.5);
    z-index: 1000;
    align-items: flex-start;
    justify-content: center;
    padding-top: 80px;
  }

  .quick-open-overlay.visible {
    display: flex;
    animation: qo-fade-in 0.1s ease;
  }

  @keyframes qo-fade-in {
    from { opacity: 0; transform: translateY(-8px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  .quick-open-panel {
    width: 560px;
    max-width: calc(100vw - 48px);
    background: var(--vscode-sidebar-bg);
    border: 1px solid var(--vscode-border);
    border-radius: 8px;
    overflow: hidden;
    box-shadow: 0 24px 64px rgba(0,0,0,0.6);
  }

  .quick-open-header {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 14px;
    border-bottom: 1px solid var(--vscode-border);
  }

  .quick-open-input {
    flex: 1;
    background: none;
    border: none;
    outline: none;
    color: var(--vscode-fg);
    font-size: 13px;
    font-family: var(--vscode-font);
  }

  .quick-open-esc {
    font-size: 10px;
    padding: 2px 6px;
    background: var(--vscode-hover-bg);
    border: 1px solid var(--vscode-border);
    border-radius: 4px;
    color: var(--vscode-sidebar-fg);
    font-family: var(--vscode-font-mono);
    cursor: pointer;
    flex-shrink: 0;
  }

  .quick-open-results {
    max-height: 340px;
    overflow-y: auto;
    padding: 4px 0;
  }

  :global(.qo-item) {
    display: flex;
    align-items: center;
    gap: 10px;
    width: 100%;
    padding: 7px 14px;
    border: none;
    background: none;
    color: var(--vscode-fg);
    font-size: 13px;
    cursor: pointer;
    text-align: left;
    transition: background 0.1s;
  }

  :global(.qo-item:hover),
  :global(.qo-item.focused) {
    background: var(--vscode-hover-bg);
  }

  :global(.qo-name) {
    flex: 1;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  :global(.qo-desc) {
    font-size: 11px;
    color: var(--vscode-sidebar-fg);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 180px;
  }
</style>
