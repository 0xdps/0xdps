---
interface ExperienceItem {
  role: string;
  company: string;
  period: string;
  technologies: string[];
  achievements: string[];
}

interface Props {
  title: string;
  items: ExperienceItem[];
}

const { title, items } = Astro.props;
---

<section class="section">
  <div class="container">
    <h2 class="section-hd">{title}</h2>
    <div class="timeline">
      {items.map((item) => (
        <div class="tl-item">
          <div class="tl-head">
            <div>
              <div class="tl-role">{item.role}</div>
              <div class="tl-company">{item.company}</div>
            </div>
            <span class="tl-period">{item.period}</span>
          </div>
          <div class="tl-techs">
            {item.technologies.map((t) => <span class="chip">{t}</span>)}
          </div>
          <ul class="tl-list">
            {item.achievements.map((a) => <li>{a}</li>)}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>
