---
interface ProjectItem {
  title: string;
  technologies: string[];
  description: string;
  achievements: string;
}

interface Props {
  title: string;
  subtitle: string;
  items: ProjectItem[];
}

const { title, subtitle, items } = Astro.props;
---

<section class="section">
  <div class="container">
    <h2 class="section-hd">{title}</h2>
    <div class="projects-stack">
      {items.map((item) => (
        <div class="proj-card">
          <div class="proj-name">{item.title}</div>
          <div class="proj-techs">
            {item.technologies.map((t) => <span class="chip chip-accent">{t}</span>)}
          </div>
          <p class="proj-desc">{item.description}</p>
          <p class="proj-impact"><strong>Impact: </strong>{item.achievements}</p>
        </div>
      ))}
    </div>
  </div>
</section>
