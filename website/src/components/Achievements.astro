---
interface AchievementItem {
  title: string;
  year: string;
  description: string;
}

interface Props {
  title: string;
  items: AchievementItem[];
}

const { title, items } = Astro.props;
---

<section class="section">
  <div class="container">
    <div class="section-label">
      <span class="section-label-text">{title}</span>
      <span class="section-rule"></span>
    </div>
    <div class="ach-list">
      {items.map((item) => (
        <div class="ach-item">
          <div class="ach-title">{item.title}</div>
          <div class="ach-year">{item.year}</div>
          <p class="ach-desc">{item.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>
