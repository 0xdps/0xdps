---
interface Props {
  personal: {
    name: string;
    title: string;
    tagline: string;
    description: string;
    location: string;
    email: string;
    resumeUrl: string;
  };
  services?: { topmateUrl: string };
}
const { personal, services } = Astro.props;
---

<section class="hero">
  <div class="container">
    <p class="hero-status">
      <span class="hero-status-dot"></span>
      Open to senior+ opportunities
    </p>
    <h1 class="hero-name">{personal.name}</h1>
    <p class="hero-tagline">{personal.tagline}</p>
    <div class="hero-actions">
      <a href={`mailto:${personal.email}`} class="btn btn-primary">Email me</a>
      <a href={personal.resumeUrl} class="btn btn-ghost" target="_blank" rel="noopener noreferrer">CV / R&eacute;sum&eacute;</a>
      {services && (
        <a href={services.topmateUrl} class="btn btn-ghost" target="_blank" rel="noopener noreferrer">Topmate &#8599;</a>
      )}
    </div>
    <p class="hero-meta">{personal.location}</p>
  </div>
</section>
