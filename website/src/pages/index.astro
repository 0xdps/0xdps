---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import About from '../components/About.astro';
import Skills from '../components/Skills.astro';
import Experience from '../components/Experience.astro';
import Projects from '../components/Projects.astro';
import SideProjects from '../components/SideProjects.astro';
import Topmate from '../components/Topmate.astro';
import Footer from '../components/Footer.astro';
import siteData from '../data/site-data.json';

const schemaJson = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Person",
  "name": "Devendra Pratap Singh",
  "alternateName": ["0xdps", "DPS"],
  "url": "https://dps.codes/",
  "image": "https://dps.codes/assets/profile/profile.webp",
  "sameAs": [
    "https://www.linkedin.com/in/0xdps",
    "https://github.com/0xdps",
    "https://twitter.com/0xdps",
    "https://medium.com/@0xdps",
    "https://topmate.io/i0xdps"
  ],
  "jobTitle": "Principal Software Engineer",
  "alumniOf": {
    "@type": "CollegeOrUniversity",
    "name": "National Institute of Technology, Bhopal"
  },
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "Delhi NCR",
    "addressCountry": "IN"
  },
  "knowsAbout": [
    "Backend Development", "System Design", "Cloud Migration", "AWS", "GCP",
    "Python", "Java", "Node.js", "Golang", "Distributed Systems", "Microservices"
  ]
});
---

<BaseLayout>
  <div class="site-wrapper">
    <Header
      logo={siteData.personal.logo}
      name={siteData.personal.name}
      socialLinks={siteData.socialLinks}
    />

    <div class="two-col-layout">
      <aside class="left-panel">
        <Hero personal={siteData.personal} services={siteData.services} />
        <Skills skills={siteData.skills} education={siteData.education} interests={siteData.about.interests} />
      </aside>

      <main class="right-panel">
        <About
          title={siteData.about.title}
          subtitle={siteData.about.subtitle}
          description={siteData.about.description}
        />

        {siteData.experience && (
          <Experience
            title={siteData.experience.title}
            items={siteData.experience.items}
          />
        )}

        {siteData.projects && (
          <Projects
            title={siteData.projects.title}
            subtitle={siteData.projects.subtitle}
            items={siteData.projects.items}
          />
        )}

        <Topmate
          title={siteData.services.title}
          subtitle={siteData.services.subtitle}
          topmateUrl={siteData.services.topmateUrl}
          offerings={siteData.services.offerings}
        />

        {siteData.sideProjects && (
          <SideProjects
            title={siteData.sideProjects.title}
            subtitle={siteData.sideProjects.subtitle}
            items={siteData.sideProjects.items}
          />
        )}

        <Footer email={siteData.personal.email} />
      </main>
    </div>
  </div>

  <script type="application/ld+json" set:html={schemaJson} />
</BaseLayout>
